# Copy to .env and adjust. Never commit real secrets.

POSTGRES_USER=jobrec
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=jobrec
POSTGRES_PORT=55432

# Used by the API container (host name is the Compose service)
DATABASE_URL=postgresql+psycopg://jobrec:change_me_in_production@postgres:5432/jobrec

API_PORT=8000
API_HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Server-side Next.js → FastAPI (Docker network)
API_INTERNAL_URL=http://backend:8000

# Browser → FastAPI (published host port)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------------------
# Phase 3 — live ingestion (Adzuna primary; keyless providers still work)
# Get free credentials at https://developer.adzuna.com/
# ---------------------------------------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
INGEST_HTTP_TIMEOUT=20
INGEST_DELAY_SECONDS=0.5

# ---------------------------------------------------------------------------
# Phase 3 — model suite (M1 skill2vec / M2 ranklet / M3 calibrator)
# Serving degrades honestly to deterministic when artifacts are absent.
# ---------------------------------------------------------------------------
SKILL2VEC_ENABLED=false            # gated transfer-cosine fallback (default off)
READINESS_CALIBRATOR_ENABLED=true  # route readiness through M3 isotonic
READINESS_BAND_HIGH=0.80           # calibrated high band  (raw fallback: 0.75)
READINESS_BAND_MEDIUM=0.60         # calibrated medium band (raw fallback: 0.50)
CALIBRATOR_POSITIVE_MIN=4          # graded label >= save counts as "positive"
RECOMMENDER_STRATEGY=deterministic # deterministic | ltr_blend | ltr_full

# ---------------------------------------------------------------------------
# Phase 3 — synthetic seeker bootstrap (scripts/seed_synthetic_users.py)
# ---------------------------------------------------------------------------
SYNTHETIC_SEED=1729

# ---------------------------------------------------------------------------
# LLM layer (plan §15) — provider abstraction with deterministic fallbacks
# when no key is present; LLM_ENABLED=false forces EVERY route to fallback.
#   OpenAI: LLM_PROVIDER=openai (default) + OPENAI_API_KEY
#   Gemini: LLM_PROVIDER=gemini + GEMINI_API_KEY  (Google AI Studio free tier)
# LLM_MODEL selects the model (e.g. gpt-4o-mini, gemini-2.5-flash).
# LLM_TIMEOUT_SECONDS bounds each provider call (default 30; raise it if the
# free tier is slow so calls fail cleanly instead of hanging).
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
# Gemini free tier (measured 2026-09-25): gemini-2.5-flash = 20 req/day and
# the 2.x line is retired (404). Recommended: gemini-3.5-flash-lite
# (>51 req/day measured, ~20 req/min on a free key; model quotas are
# per-model and reset at midnight Pacific).
LLM_ENABLED=true

# Opt-in explanation polish (plan §12): the LLM rewrites explanation wording
# only — a digit-multiset validator discards the polish unless every number
# survives verbatim. Default off.
EXPLAIN_LLM=false

# TEMPORARY trial mode: true → AI paths raise LlmStrictError (HTTP 502 with
# the reason) instead of silently using deterministic fallbacks — use it to
# see which features actually work with the LLM, then set it back to false.
LLM_STRICT=false

# ---------------------------------------------------------------------------
# Auto-ingestion timer (docker compose service 'ingest') — seconds between
# full query cycles; the rotating query set lives in docker-compose.yml.
# ---------------------------------------------------------------------------
INGEST_INTERVAL_SECONDS=21600
