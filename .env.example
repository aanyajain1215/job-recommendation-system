# Copy to .env and adjust. Never commit real secrets.

POSTGRES_USER=jobrec
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=jobrec
POSTGRES_PORT=55432

# Used by the API container (host name is the Compose service)
DATABASE_URL=postgresql+psycopg://jobrec:change_me_in_production@postgres:5432/jobrec

API_PORT=8000
API_HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Server-side Next.js → FastAPI (Docker network)
API_INTERNAL_URL=http://backend:8000

# Browser → FastAPI (published host port)
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
